# --- OpenTofu / Terraform ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# tfvars and backend.hcl are generated by the bootstrap script and hold
# account-specific values; commit terraform.tfvars.example instead
*.tfvars
*.tfvars.json
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
*tfplan*
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is deliberately NOT ignored; commit it so
# provider versions are reproducible

# --- Ansible ---
# hosts.ini is generated by tofu (local_file) and contains IPs
ansible/hosts.ini
ansible/.vault_key
*.retry
.ansible/

# --- Secrets and keys ---
*.pem
*.key
id_ed25519
id_ed25519.*
!*.pub
.env
.env.*
!.env.example

# --- Vote (Python) / result (Node.js) / worker (.NET) ---
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
worker/bin/
worker/obj/

# --- Editors / OS ---
*~
*.swp
.idea/
.vscode/
.DS_Store


# OpenSSL-related files best not committed

## Certificate Authority
*.ca

## Certificate
*.crt

## Certificate Sign Request
*.csr

## Certificate
*.der

## Key database file
*.kdb

## OSCP request data
*.org

## PKCS #12
*.p12

## PEM-encoded certificate data
*.pem

## Random number seed
*.rnd

## SSLeay data
*.ssleay

## S/MIME message
*.smime



